#include <stdio.h>
#define INF 9999
#define MAX 20

void prim(int graph[MAX][MAX], int n)
{
    int selected[MAX] = {0};
    int edges = 0;
    int i, j, x, y;
    int min;
    int total = 0;

    selected[0] = 1;

    printf("\nEdges in Minimum Spanning Tree:\n");

    while (edges < n - 1)
    {
        min = INF;
        x = -1;
        y = -1;

        for (i = 0; i < n; i++)
        {
            if (selected[i])
            {
                for (j = 0; j < n; j++)
                {
                    if (!selected[j] && graph[i][j] < min)
                    {
                        min = graph[i][j];
                        x = i;
                        y = j;
                    }
                }
            }
        }

        if (x == -1)
        {
            printf("Graph is not connected.\n");
            return;
        }

        printf("%d - %d : %d\n", x + 1, y + 1, min);

        total += min;
        selected[y] = 1;
        edges++;
    }

    printf("Total cost of MST = %d\n", total);
}

int main()
{
    int graph[MAX][MAX];
    int n, i, j;

    printf("Enter number of vertices: ");
    scanf("%d", &n);

    printf("Enter the adjacency matrix:\n");
    printf("(Enter 9999 for no edge)\n");

    for (i = 0; i < n; i++)
    {
        for (j = 0; j < n; j++)
        {
            scanf("%d", &graph[i][j]);
        }
    }

    prim(graph, n);

    return 0;
}
